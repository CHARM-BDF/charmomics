[
    {
        "type": "subprocess",
        "command": ["whoami"]
    },
    {
        "type": "subprocess",
        "command": ["python", "--version"]
    },
    {
        "type":"subprocess",
        "command": "bcftools norm -m- -w 10000 -f ./etc/data/external/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna -cwx -Ob {raw_path}/{sample}.vcf.gz -o {interim_path}/{sample}.bcftools.vcf",
        "dependencies": [
            "raw_path",
            "interim_path",
            "sample"
        ]
    },
    {
        "type": "subprocess",
        "command": "echtvar anno -e ./etc/data/external/gnomad.v3.1.2.echtvar.v2.zip -i 'gnomad_popmax_af < 0.07' {interim_path}/{sample}.bcftools.vcf {interim_path}/{sample}.bcftools.echtvar.vcf",
        "dependencies": [
            "raw_path",
            "interim_path",
            "sample"
        ]
    }
]
